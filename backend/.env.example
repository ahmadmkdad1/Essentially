# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma separated list of allowed origins, or * for any (development only)
CORS_ORIGINS=*

# --- Database -------------------------------------------------------------
# postgres (recommended) or sqlite (zero-setup local file)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=essentially
# Only used when DB_TYPE=sqlite
DB_SQLITE_PATH=data/essentially.sqlite
# Auto-sync schema from entities. Disable in production and use migrations.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Bootstrap admin (created on first start if missing) -----------------
# Leave ADMIN_PASSWORD empty to skip creating the admin account.
ADMIN_EMAIL=admin@essentially.app
ADMIN_PASSWORD=
ADMIN_NAME=Admin Team
